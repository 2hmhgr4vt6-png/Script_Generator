# ---------------------------------------------------------------------------
# Bhasika AI Content Studio — environment template
# Copy to .env.local and fill in. Never commit .env.local.
#
# The studio has no sign-in. Anyone who can reach the URL can use it and read
# everything in it, so run it on localhost or behind your own access control
# (VPN, SSO proxy, platform password protection).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Credential encryption -------------------------------------------------
# API keys added through Settings are encrypted with AES-256-GCM before being
# stored. Set this to any long random string:  openssl rand -base64 32
# If it is unset, a key is generated and written to data/credentials.key, which
# is fine on one machine but does not survive a redeploy or span instances.
# CREDENTIALS_SECRET=

# --- Database (optional) ----------------------------------------------------
# Without DATABASE_URL the studio uses a local JSON file at data/store.json,
# which is fine for development but not for production.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Providers --------------------------------------------------------------
# Everything below is optional here: the same values can be entered in
# Settings → API keys, which stores them encrypted in the database. A value
# saved in Settings takes precedence over the matching variable here.

# --- AI provider (optional; demo mode without it) ---------------------------
# Which provider writes the scripts. Leave unset to use the first one
# configured, in free-first order.
# AI_PROVIDER=gemini   # gemini | groq | openrouter | ollama | openai | anthropic

# FREE, no payment method required -------------------------------------------
# Google Gemini — key from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Groq — key from https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — key from https://openrouter.ai/keys; ":free" models cost nothing
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — runs on your own machine, no key at all. https://ollama.com/download
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# PAID — both of these require a payment method on the provider's account -----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Search provider (optional; demo mode without it) -----------------------
# Tavily has a free monthly allowance and needs no card: https://app.tavily.com/home
# SEARCH_PROVIDER=tavily      # tavily | serper | exa
# SEARCH_API_KEY=

# --- Social sources (optional) ---------------------------------------------
# Reddit: create an app at https://www.reddit.com/prefs/apps (type: script)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=bhasika-content-studio/1.0 by your-reddit-username

# YouTube Data API v3 key
# YOUTUBE_API_KEY=

# Meta Graph API tokens. These read the posts and comments of the account the
# token manages — Meta does not offer platform-wide keyword search.
# FACEBOOK_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=

# --- Development -----------------------------------------------------------
# Force demo mode even when keys are present.
# BHASIKA_DEMO_MODE=false
