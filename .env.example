# ---------------------------------------------------------------------------
# Bhasika AI Content Studio — environment template
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (required) ---------------------------------------------
# Signs the session cookie. Generate your own:  openssl rand -base64 32
AUTH_SECRET=generate-your-own-with-openssl-rand-base64-32
AUTH_SESSION_TTL_HOURS=12

# The admin account created on first sign-in.
# Generate the hash with:  npm run hash-password
# Only the bcrypt hash belongs here — never the plaintext password.
#
# IMPORTANT: escape every "$" as "\$". Dotenv expands unescaped $VAR when the
# file is loaded, which silently truncates a bcrypt hash. If your hosting
# provider's UI makes that awkward, set BHASIKA_ADMIN_PASSWORD_HASH_B64 to the
# base64 of the hash instead:  printf '%s' "$HASH" | base64
BHASIKA_ADMIN_EMAIL=admin@bhasika.com
BHASIKA_ADMIN_PASSWORD_HASH=\$2a\$12\$FGfvCef9SyLA/CxxbBmwb.lL3yV0AgVqxiT.YRjGpEbBFY/yViR4K
# BHASIKA_ADMIN_PASSWORD_HASH_B64=

# --- Database (optional) ----------------------------------------------------
# Without DATABASE_URL the studio uses a local JSON file at data/store.json,
# which is fine for development but not for production.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional; demo mode without it) ---------------------------
# AI_PROVIDER=openai          # openai | anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Search provider (optional; demo mode without it) -----------------------
# SEARCH_PROVIDER=tavily      # tavily | serper | exa
# SEARCH_API_KEY=

# --- Social sources (optional) ---------------------------------------------
# Reddit: create an app at https://www.reddit.com/prefs/apps (type: script)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=bhasika-content-studio/1.0 by your-reddit-username

# YouTube Data API v3 key
# YOUTUBE_API_KEY=

# Meta Graph API tokens. These read the posts and comments of the account the
# token manages — Meta does not offer platform-wide keyword search.
# FACEBOOK_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=

# --- Development -----------------------------------------------------------
# Force demo mode even when keys are present.
# BHASIKA_DEMO_MODE=false
